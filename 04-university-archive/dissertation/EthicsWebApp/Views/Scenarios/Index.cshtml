@model IEnumerable<EthicsWebApp.Models.Scenario>

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Index</title>
</head>
<body>
<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Background)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Var1)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Var2)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Attr1)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Attr2)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Background)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Var1)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Var2)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Attr1)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Attr2)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.SceID">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.SceID">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.SceID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
</body>
</html>
